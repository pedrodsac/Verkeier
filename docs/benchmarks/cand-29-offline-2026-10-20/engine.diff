diff --git "a/Sources/Mobilit\303\251itKit/Routing/JourneyPlanningSession+TransferFirst.swift" "b/Sources/Mobilit\303\251itKit/Routing/JourneyPlanningSession+TransferFirst.swift"
new file mode 100644
index 0000000..1d53a65
--- /dev/null
+++ "b/Sources/Mobilit\303\251itKit/Routing/JourneyPlanningSession+TransferFirst.swift"
@@ -0,0 +1,44 @@
+import Foundation
+
+extension JourneyPlanningSession {
+    /// CAND-29 (experiment, off unless the process environment sets `CAND29`): discovery still decides
+    /// which stops qualify with its optimistic walking-chain envelope, but orders them by the tighter
+    /// one-batch reachability RAPTOR itself uses. A stop one ride from the destination comes first,
+    /// then two, then three, and a stop the destination can be walked to comes last. `CAND29=1` only
+    /// reorders; `CAND29=cap<N>` also lets at most N zero-ride boards into one discovery. `CAND29=arr` is an
+    /// exploratory variant outside the plan: equal ranks break by the earliest arrival at the stop, then distance.
+    struct TransferFirstOrdering {
+        static let zeroRank = 1_000
+        static let unreachableRank = 2_000
+        /// Whether the ordering is used; when false the type only labels stops for the debug log.
+        let active: Bool
+        /// Maximum number of destination-walkable (and tight-unreachable) boards per discovery.
+        let zeroCap: Int?
+        /// Exploratory: break rank ties by arrival time before distance to the destination.
+        let arrivalTiebreak: Bool
+        private let reachability: Raptor.DestinationReachability
+
+        init?(snapshot: RoutingSnapshot, egress: [Edge], maxRides: Int) {
+            let setting = ProcessInfo.processInfo.environment["CAND29"] ?? ""
+            let active = !setting.isEmpty && setting != "0"
+            guard active || PassDebug.enabled else { return nil }
+            self.active = active
+            self.zeroCap = setting.hasPrefix("cap") ? Int(setting.dropFirst(3)) : nil
+            self.arrivalTiebreak = setting == "arr"
+            let started = ContinuousClock.now
+            // The same bound `Raptor.search` builds (and caches) for its executable rounds.
+            reachability = Raptor.DestinationReachability(snapshot: snapshot,
+                egressStops: Set(egress.map(\.stop)), maxRides: maxRides)
+            PassDebug.log("cand29 reachability built in \(started.duration(to: .now)) active=\(active) cap=\(zeroCap.map(String.init) ?? "-")")
+        }
+
+        func rank(_ stop: Int) -> Int {
+            guard let level = reachability.stopsByRemainingRides.firstIndex(where: { $0[stop] }) else {
+                return Self.unreachableRank
+            }
+            return level == 0 ? Self.zeroRank : level
+        }
+
+        func isZeroRide(_ stop: Int) -> Bool { rank(stop) >= Self.zeroRank }
+    }
+}
diff --git "a/Sources/Mobilit\303\251itKit/Routing/PassDebug.swift" "b/Sources/Mobilit\303\251itKit/Routing/PassDebug.swift"
new file mode 100644
index 0000000..7a26080
--- /dev/null
+++ "b/Sources/Mobilit\303\251itKit/Routing/PassDebug.swift"
@@ -0,0 +1,91 @@
+import Foundation
+
+// Temporary diagnostics for the pass-2 investigation (scratch copy only, never committed).
+enum PassDebug {
+    static let formatter: DateFormatter = {
+        let f = DateFormatter()
+        f.dateFormat = "HH:mm:ss"
+        f.timeZone = TimeZone(identifier: "Europe/Luxembourg")
+        f.locale = Locale(identifier: "en_US_POSIX")
+        return f
+    }()
+    static func t(_ d: Date?) -> String { d.map { formatter.string(from: $0) } ?? "-" }
+    static let enabled = ProcessInfo.processInfo.environment["PASS_DEBUG"] == "1"
+    static func log(_ s: @autoclosure () -> String) { guard enabled else { return }; print("ROUTING_DEBUG " + s()); fflush(stdout) }
+}
+
+extension JourneyPlanningSession {
+    func debugDescribe(_ journeys: [Journey], label: String) {
+        guard PassDebug.enabled else { return }
+        PassDebug.log("\(label) count=\(journeys.count)")
+        for journey in journeys {
+            var parts: [String] = []
+            for leg in journey.legs {
+                switch leg {
+                case let .transit(ride):
+                    let key = ride.instance.map { RealtimePatchKey(tripID: ride.tripID, serviceDate: $0.serviceDate) }
+                    let patch = key.flatMap { latestPatchesByInstance[$0] }
+                    let board = ride.boardSequence.flatMap { patch?.event(stopID: ride.board.stop.id, sequence: $0) }
+                    let alight = ride.alightSequence.flatMap { patch?.event(stopID: ride.alight.stop.id, sequence: $0) }
+                    parts.append("\(ride.route.shortName ?? "?")[\(ride.tripID)] \(ride.board.stop.id)@\(PassDebug.t(ride.effectiveDeparture))(s\(PassDebug.t(ride.scheduledDeparture)),\(board?.departureSource.rawValue ?? "nopatch")) -> \(ride.alight.stop.id)@\(PassDebug.t(ride.effectiveArrival))(\(alight?.arrivalSource.rawValue ?? "nopatch"))")
+                case .walk: parts.append("walk")
+                case .inSeatContinuation: parts.append("stay")
+                }
+            }
+            PassDebug.log("  \(journey.id.value) \(parts.joined(separator: " | "))")
+        }
+    }
+
+    /// Same checks as `routingEffectChanged`, but lists every trip that changes routing inputs.
+    func debugRoutingEffect(from previous: [RealtimePatchKey: RealtimeTripPatch]) {
+        guard PassDebug.enabled else { return }
+        var changedTrips = 0, effectTrips = 0
+        for (key, patch) in latestPatchesByInstance.sorted(by: { $0.key.tripID < $1.key.tripID }) where patch != previous[key] {
+            changedTrips += 1
+            guard let tripIndex = snapshot.tripByID[key.tripID] else { PassDebug.log("  effect? \(key.tripID) not in snapshot"); continue }
+            let trip = snapshot.trips[tripIndex]
+            let line = snapshot.routes[trip.route].shortName ?? "?"
+            let old = previous[key]
+            if patch.status != (old?.status ?? .active) {
+                effectTrips += 1
+                PassDebug.log("  effect \(line)[\(key.tripID)] status \(String(describing: old?.status)) -> \(patch.status) new=\(old == nil)")
+                continue
+            }
+            guard patch.status == .active else { continue }
+            for time in trip.times {
+                let stopID = snapshot.stops[time.stop].id
+                let before = old?.event(stopID: stopID, sequence: time.sequence)
+                let after = patch.event(stopID: stopID, sequence: time.sequence)
+                let scheduledDeparture = time.departure.map { snapshot.date(serviceDate: key.serviceDate, serviceSeconds: $0) }
+                let scheduledArrival = time.arrival.map { snapshot.date(serviceDate: key.serviceDate, serviceSeconds: $0) }
+                let oldDeparture = before?.effectiveDeparture ?? scheduledDeparture
+                let newDeparture = after?.effectiveDeparture ?? scheduledDeparture
+                let oldArrival = before?.effectiveArrival ?? scheduledArrival
+                let newArrival = after?.effectiveArrival ?? scheduledArrival
+                var reason: String?
+                if oldDeparture != newDeparture || oldArrival != newArrival {
+                    reason = "times dep \(PassDebug.t(oldDeparture))->\(PassDebug.t(newDeparture)) arr \(PassDebug.t(oldArrival))->\(PassDebug.t(newArrival)) sched \(PassDebug.t(scheduledDeparture)) src \(after?.departureSource.rawValue ?? "-")/\(after?.arrivalSource.rawValue ?? "-")"
+                } else if (before?.boardingAllowed != false) != (after?.boardingAllowed != false)
+                    || (before?.alightingAllowed != false) != (after?.alightingAllowed != false) {
+                    reason = "boarding/alighting allowed"
+                } else {
+                    func deadline(_ event: RealtimeStopEventPatch?, effective: Date?) -> Date? {
+                        if event?.departureSource == .estimated, let scheduledDeparture, let effective {
+                            return min(scheduledDeparture, effective)
+                        }
+                        return effective
+                    }
+                    if deadline(before, effective: oldDeparture) != deadline(after, effective: newDeparture) {
+                        reason = "deadline \(before?.departureSource.rawValue ?? "-")->\(after?.departureSource.rawValue ?? "-")"
+                    }
+                }
+                if let reason {
+                    effectTrips += 1
+                    PassDebug.log("  effect \(line)[\(key.tripID)] stop \(stopID) seq \(time.sequence) new=\(old == nil) \(reason)")
+                    break
+                }
+            }
+        }
+        PassDebug.log("  patched trips changed=\(changedTrips) withRoutingEffect=\(effectTrips)")
+    }
+}
