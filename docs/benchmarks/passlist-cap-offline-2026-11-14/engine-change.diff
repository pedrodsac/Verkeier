+/// Two boards of one trip: the first estimates a stop from its own report in seconds, the second
+/// reports the next stop in whole minutes, a little earlier.
+@Suite struct RealtimeTripPatchMergeClampTests {
+    static func at(_ time: String) -> Date { RealtimeTestFixture.date(time) }
+
+    static func patches(estimate: String) throws -> (first: RealtimeTripPatch, second: RealtimeTripPatch) {
+        let date = try GTFSDate(parsing: "20260930")
+        let observed = at("08:05:00"), later = at("08:05:10")
+        let first = RealtimeTripPatch(tripID: "trip", serviceDate: date, events: [
+            .init(stopID: "a", scheduledDeparture: at("08:00:00"), effectiveDeparture: at("08:08:00"),
+                  departureSource: .reported, stopSequence: 1, observedAt: observed),
+            .init(stopID: "x", scheduledDeparture: at("08:10:30"), effectiveDeparture: at(estimate),
+                  departureSource: .estimated, scheduledArrival: at("08:10:30"), effectiveArrival: at(estimate),
+                  arrivalSource: .estimated, stopSequence: 2, observedAt: observed),
+            .init(stopID: "b", scheduledDeparture: at("08:11:00"), effectiveDeparture: at("08:19:00"),
+                  departureSource: .estimated, scheduledArrival: at("08:11:00"), effectiveArrival: at("08:19:00"),
+                  arrivalSource: .estimated, stopSequence: 3, observedAt: observed),
+        ])
+        let second = RealtimeTripPatch(tripID: "trip", serviceDate: date, events: [
+            .init(stopID: "a", scheduledDeparture: at("08:00:00"), effectiveDeparture: at("08:00:00"),
+                  stopSequence: 1, observedAt: later),
+            .init(stopID: "x", scheduledDeparture: at("08:10:30"), effectiveDeparture: at("08:10:30"),
+                  scheduledArrival: at("08:10:30"), effectiveArrival: at("08:10:30"), stopSequence: 2,
+                  observedAt: later),
+            .init(stopID: "b", scheduledDeparture: at("08:11:00"), effectiveDeparture: at("08:18:00"),
+                  departureSource: .reported, scheduledArrival: at("08:11:00"), effectiveArrival: at("08:18:00"),
+                  arrivalSource: .reported, stopSequence: 3, observedAt: later),
+        ])
+        return (first, second)
+    }
+
+    @Test func mergeClampsAnEstimateThatOvershootsAMinuteReport() throws {
+        let (first, second) = try Self.patches(estimate: "08:18:30")
+        let merged = first.merging(second)
+        #expect(merged.isChronological)
+        #expect(merged.events[0].effectiveDeparture == Self.at("08:08:00"))
+        #expect(merged.events[0].departureSource == .reported)
+        #expect(merged.events[1].effectiveArrival == Self.at("08:18:00"))
+        #expect(merged.events[1].effectiveDeparture == Self.at("08:18:00"))
+        #expect(merged.events[1].arrivalSource == .estimated)
+        #expect(merged.events[2].effectiveArrival == Self.at("08:18:00"))
+        #expect(merged.events[2].arrivalSource == .reported)
+    }
+
+    @Test func mergeKeepsTheNewerPatchWhenTheConflictIsLarger() throws {
+        let (first, second) = try Self.patches(estimate: "08:20:00")
+        let merged = first.merging(second)
+        #expect(merged == second)
+    }
+}
