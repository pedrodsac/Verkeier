index 0000000..bdb4dbd
--- /dev/null
+++ "b/Sources/Mobilit\303\251itKit/Routing/HafasRealtimeRoutingProvider+CappedPasslist.swift"
@@ -0,0 +1,46 @@
+import Foundation
+
+extension HafasRealtimeRoutingProvider {
+    /// The `passlistMaxStops` every routing board sends. ATP keeps the board stop, the next eight stops and
+    /// the terminus, and leaves out the stops between; ten cuts about 44 % of board bytes, with the same
+    /// routes in the passlist-cap replays (`docs/benchmarks/passlist-cap-offline-2026-11-14` in the app).
+    ///
+    /// A stop board that routing should reuse from the cache must send the same cap: the cap is part of
+    /// the cache scope, so an uncapped board with a passlist no longer supplies routing.
+    public nonisolated static let routingPasslistMaximumStops = 10
+
+    /// The board every routing fetch and cache lookup uses. All of them must send the same cap, because
+    /// the board cache keys its coverage on every query item except the window. `wholePasslists` (trip
+    /// detail, see `RealtimeRoutingRequest.wholePasslists`) drops the cap; it has no default so that
+    /// every fetch and lookup of one request takes it from that request.
+    nonisolated static func routingBoardRequest(client: MobiliteitAPIClient, stopID: String, from start: Date,
+                                                duration: TimeInterval, lines: [String] = [],
+                                                wholePasslists: Bool)
+        -> HafasDepartureBoardRequest {
+        let (date, time) = requestDateAndTime(start)
+        return .init(stationID: stopID, language: client.language ?? "en", date: date, time: time,
+                     durationMinutes: max(1, Int(ceil(duration / 60))), maximumJourneys: -1, lines: lines,
+                     realtimeMode: .serverDefault, includePasslist: true,
+                     passlistMaximumStops: wholePasslists ? nil : routingPasslistMaximumStops)
+    }
+
+    /// The trip positions a capped passlist leaves out: after the last aligned stop before the terminus,
+    /// and before the terminus (or through the end of the trip when the terminus did not align). Nil when
+    /// no stop before the terminus aligned, since there is then no reported delay to carry.
+    ///
+    /// A passlist counts as capped when it holds exactly `maximumStops` entries and the last two are not
+    /// neighbours by HAFAS route index (or either index is missing). A full passlist of that length keeps
+    /// neighbouring indices at the end, so its unreported stops keep the usual estimate horizon.
+    nonisolated static func cappedPasslistGap(_ passlist: [HafasPasslistStop], aligned: [Int: HafasPasslistStop],
+                                              stopCount: Int,
+                                              maximumStops: Int = routingPasslistMaximumStops) -> Range<Int>? {
+        guard maximumStops >= 2, passlist.count == maximumStops, let terminus = passlist.last else { return nil }
+        if let before = passlist[passlist.count - 2].routeIndex, let last = terminus.routeIndex,
+           last - before == 1 {
+            return nil
+        }
+        guard let lastBeforeGap = aligned.filter({ $0.value != terminus }).keys.max() else { return nil }
+        let end = aligned.first { $0.value == terminus }?.key ?? stopCount
+        return lastBeforeGap + 1 < end ? lastBeforeGap + 1..<end : nil
+    }
+}
