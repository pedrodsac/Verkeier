+++ "b/Tests/Mobilit\303\251itKitTests/CappedPasslistTests.swift"
@@ -0,0 +1,249 @@
+import Foundation
+import Testing
+@testable import MobiliteitKit
+
+/// ATP's `passlistMaxStops=K` keeps the board stop, the next K - 2 stops and the terminus. The stops
+/// between are left out, and the patch carries the delay before them through to the terminus.
+@Suite struct CappedPasslistTests {
+    /// Fourteen stops: s01-s09 two minutes apart from 08:00, then s10-s14 at 08:30, 08:45, 09:00, 09:15
+    /// and 09:30, so s12 and s13 lie more than 30 minutes after s09.
+    static let times = ["08:00", "08:02", "08:04", "08:06", "08:08", "08:10", "08:12", "08:14", "08:16",
+                        "08:30", "08:45", "09:00", "09:15", "09:30"]
+
+    static func stopID(_ index: Int) -> String { String(format: "s%02d", index + 1) }
+
+    static func fixture() async throws -> RealtimeTestFixture {
+        let stops = times.indices.map { "\(stopID($0)),Stop \($0 + 1),49.\(60 + $0),6.\(10 + $0)\n" }.joined()
+        let stopTimes = times.enumerated().map { index, time in
+            "trip,\(time):00,\(time):00,\(stopID(index)),\(index + 1)\n"
+        }.joined()
+        return try await RealtimeTestFixture(stopTimes: stopTimes, additionalStops: stops)
+    }
+
+    static func shifted(_ time: String, minutes: Int) -> String {
+        let parts = time.split(separator: ":").compactMap { Int($0) }
+        let total = parts[0] * 60 + parts[1] + minutes
+        return String(format: "%02d:%02d:00", total / 60, total % 60)
+    }
+
+    /// The board at s01 as ATP returns it with K = 10: s01-s09 and the terminus, each delayed.
+    static func board(delayMinutes: Int, terminusRouteIndex: Int?) -> String {
+        var rows = (0..<9).map { index in
+            liveStop(stopID(index), planned: "\(times[index]):00",
+                     predicted: shifted(times[index], minutes: delayMinutes), extra: ",\"routeIdx\":\(index)")
+        }
+        let terminus = shifted(times[13], minutes: delayMinutes)
+        rows.append(liveStop(stopID(13), planned: "\(times[13]):00", predicted: terminus, arrival: terminus,
+                             extra: terminusRouteIndex.map { ",\"routeIdx\":\($0)" } ?? ""))
+        return liveBoard(stops: rows.joined(separator: ","), realtime: shifted(times[0], minutes: delayMinutes),
+                         stop: stopID(0))
+    }
+
+    static func patch(delayMinutes: Int, terminusRouteIndex: Int?) async throws
+        -> (patch: RealtimeTripPatch?, requests: [URLRequest]) {
+        let fixture = try await fixture(); defer { fixture.remove() }
+        let body = board(delayMinutes: delayMinutes, terminusRouteIndex: terminusRouteIndex)
+        let (client, host) = RealtimeBoardProtocol.client { _ in body }; defer { RealtimeBoardProtocol.remove(host) }
+        let provider = try HafasRealtimeRoutingProvider(databaseURL: fixture.database, client: client)
+        let batch = try await provider.patches(for: .init(stopIDs: [stopID(0)],
+            from: RealtimeTestFixture.date("08:00:00"), through: RealtimeTestFixture.date("08:30:00")))
+        return (batch.patches.first, RealtimeBoardProtocol.requests(host))
+    }
+
+    @Test func routingBoardsAskForTenStops() async throws {
+        let requests = try await Self.patch(delayMinutes: 0, terminusRouteIndex: 13).requests
+        let url = try #require(requests.first?.url)
+        let params = try #require(URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems)
+        #expect(params.first { $0.name == "passlist" }?.value == "1")
+        #expect(params.first { $0.name == "passlistMaxStops" }?.value == "10")
+    }
+
+    @Test func capIsSentOnlyWithAPasslistAndSurvivesIntervals() async throws {
+        let (client, host) = RealtimeBoardProtocol.client { _ in liveBoard(stops: "") }
+        defer { RealtimeBoardProtocol.remove(host) }
+        for (stationID, passlist) in [("a", false), ("b", true)] {
+            _ = try await client.departureBoard(.init(stationID: stationID, includePasslist: passlist,
+                                                      passlistMaximumStops: 10), refreshPolicy: .forceRefresh)
+        }
+        let values = RealtimeBoardProtocol.requests(host).compactMap(\.url).map { url in
+            URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems?
+                .first { $0.name == "passlistMaxStops" }?.value
+        }
+        #expect(values == [nil, "10"])
+        let request = HafasDepartureBoardRequest(stationID: "a", includePasslist: true, passlistMaximumStops: 10)
+        #expect(request.covering(.init(start: .now, duration: 600)).passlistMaximumStops == 10)
+    }
+
+    /// Without the gap rule, s12 falls back to its timetable time, 09:00, after s11's estimate of 09:05.
+    /// The patch would not be chronological, and the trip would lose its delay.
+    @Test func cappedPasslistCarriesTheDelayToTheTerminus() async throws {
+        let patch = try #require(try await Self.patch(delayMinutes: 20, terminusRouteIndex: 13).patch)
+        #expect(patch.isChronological)
+        #expect(patch.events[8].departureSource == .reported)
+        for (index, time) in [(10, "09:05:00"), (11, "09:20:00"), (12, "09:35:00")] {
+            #expect(patch.events[index].effectiveArrival == RealtimeTestFixture.date(time))
+            #expect(patch.events[index].arrivalSource == .estimated)
+            #expect(patch.events[index].departureSource == .estimated)
+        }
+        #expect(patch.events[13].effectiveArrival == RealtimeTestFixture.date("09:50:00"))
+        #expect(patch.events[13].arrivalSource == .reported)
+    }
+
+    /// Ten stops whose last two are route neighbours are a whole passlist, not a capped one: a stop the
+    /// timetable has and ATP does not keeps the 30-minute horizon.
+    @Test func neighbouringTerminusKeepsTheHorizon() async throws {
+        let patch = try #require(try await Self.patch(delayMinutes: 10, terminusRouteIndex: 9).patch)
+        #expect(patch.events[10].effectiveArrival == RealtimeTestFixture.date("08:55:00"))
+        #expect(patch.events[10].arrivalSource == .estimated)
+        for index in [11, 12] {
+            #expect(patch.events[index].effectiveArrival == patch.events[index].scheduledArrival)
+            #expect(patch.events[index].arrivalSource == .scheduled)
+        }
+    }
+
+    static func passlist(count: Int, routeIndices: [Int?]) throws -> [HafasPasslistStop] {
+        try (0..<count).map { index in
+            let extra = routeIndices[index].map { ",\"routeIdx\":\($0)" } ?? ""
+            let json = liveStop(stopID(index), planned: String(format: "08:%02d:00", index), extra: extra)
+            return try JSONDecoder().decode(HafasPasslistStop.self, from: Data(json.utf8))
+        }
+    }
+
+    static func aligned(_ passlist: [HafasPasslistStop], positions: [Int?]) -> [Int: HafasPasslistStop] {
+        Dictionary(uniqueKeysWithValues: zip(positions, passlist).compactMap { position, stop in
+            position.map { ($0, stop) }
+        })
+    }
+
+    @Test func gapLiesBetweenTheLastStopBeforeItAndTheTerminus() throws {
+        let stops = try Self.passlist(count: 10, routeIndices: Array(0..<9) + [13])
+        let positions: [Int?] = Array(0..<9) + [13]
+        #expect(HafasRealtimeRoutingProvider.cappedPasslistGap(stops, aligned: Self.aligned(stops, positions: positions),
+                                                               stopCount: 14) == 9..<13)
+        // An unaligned stop before the gap moves its start back; an unaligned terminus extends it to the end.
+        let shifted: [Int?] = Array(0..<8) + [nil, nil]
+        #expect(HafasRealtimeRoutingProvider.cappedPasslistGap(stops, aligned: Self.aligned(stops, positions: shifted),
+                                                               stopCount: 14) == 8..<14)
+        let missingIndices = try Self.passlist(count: 10, routeIndices: Array(repeating: nil, count: 10))
+        #expect(HafasRealtimeRoutingProvider.cappedPasslistGap(missingIndices,
+            aligned: Self.aligned(missingIndices, positions: positions), stopCount: 14) == 9..<13)
+    }
+
+    @Test func wholeOrUnalignedPasslistsHaveNoGap() throws {
+        let neighbours = try Self.passlist(count: 10, routeIndices: Array(0..<10))
+        #expect(HafasRealtimeRoutingProvider.cappedPasslistGap(neighbours,
+            aligned: Self.aligned(neighbours, positions: Array(0..<9) + [13]), stopCount: 14) == nil)
+        let short = try Self.passlist(count: 9, routeIndices: Array(0..<8) + [13])
+        #expect(HafasRealtimeRoutingProvider.cappedPasslistGap(short,
+            aligned: Self.aligned(short, positions: Array(0..<8) + [13]), stopCount: 14) == nil)
+        let capped = try Self.passlist(count: 10, routeIndices: Array(0..<9) + [13])
+        #expect(HafasRealtimeRoutingProvider.cappedPasslistGap(capped,
+            aligned: Self.aligned(capped, positions: Array(repeating: nil, count: 9) + [13]), stopCount: 14) == nil)
+    }
+
+    /// The board at s01 with its whole passlist, every stop reported `delayMinutes` late.
+    static func wholeBoard(delayMinutes: Int) -> String {
+        let rows = times.indices.map { index in
+            let predicted = shifted(times[index], minutes: delayMinutes)
+            return liveStop(stopID(index), planned: "\(times[index]):00", predicted: predicted,
+                            arrival: index == times.count - 1 ? predicted : nil, extra: ",\"routeIdx\":\(index)")
+        }
+        return liveBoard(stops: rows.joined(separator: ","), realtime: shifted(times[0], minutes: delayMinutes),
+                         stop: stopID(0))
+    }
+
+    static func passlistCap(_ request: URLRequest) -> String? {
+        URLComponents(url: request.url!, resolvingAgainstBaseURL: false)?.queryItems?
+            .first { $0.name == "passlistMaxStops" }?.value
+    }
+
+    /// Trip detail shows live times only for reported stops, so it asks for the whole passlist and
+    /// keeps them for the stops a routing board would leave out.
+    @Test func tripDetailAsksForWholePasslists() async throws {
+        let fixture = try await Self.fixture(); defer { fixture.remove() }
+        // Answer as ATP does: a capped board when the request sends the cap.
+        let whole = Self.wholeBoard(delayMinutes: 20), capped = Self.board(delayMinutes: 20, terminusRouteIndex: 13)
+        let (client, host) = RealtimeBoardProtocol.client { Self.passlistCap($0) == nil ? whole : capped }
+        defer { RealtimeBoardProtocol.remove(host) }
+        let provider = try HafasRealtimeRoutingProvider(databaseURL: fixture.database, client: client)
+        let router = try await TransitRouter(databaseURL: fixture.database, realtimeProvider: provider)
+        let generation = await router.snapshot.info.generation
+        let result = try await router.tripSnapshot(for: .init(feedGeneration: generation, tripID: "trip",
+            serviceDate: try GTFSDate(parsing: "20260930")), boardingSequence: 1)
+        let requests = RealtimeBoardProtocol.requests(host)
+        #expect(!requests.isEmpty)
+        #expect(requests.allSatisfy { Self.passlistCap($0) == nil })
+        #expect(result.stops.map { $0.departure?.realtime }
+            == Self.times.map { RealtimeTestFixture.date(Self.shifted($0, minutes: 20)) })
+    }
+
+    /// The cap is part of the board cache scope: a routing board doesn't answer trip detail, and the
+    /// whole-passlist board trip detail fetched doesn't answer routing.
+    @Test func routingAndTripDetailBoardsAreCachedApart() async throws {
+        let fixture = try await Self.fixture(); defer { fixture.remove() }
+        let body = Self.wholeBoard(delayMinutes: 0)
+        let (client, host) = RealtimeBoardProtocol.client { _ in body }; defer { RealtimeBoardProtocol.remove(host) }
+        let provider = try HafasRealtimeRoutingProvider(databaseURL: fixture.database, client: client)
+        let window = (from: RealtimeTestFixture.date("07:58:00"), through: RealtimeTestFixture.date("08:30:00"))
+        func fetch(wholePasslists: Bool) async throws {
+            _ = try await provider.patches(for: .init(stopIDs: [Self.stopID(0)], from: window.from,
+                through: window.through, wholePasslists: wholePasslists))
+        }
+        try await fetch(wholePasslists: false)
+        try await fetch(wholePasslists: true)
+        try await fetch(wholePasslists: false)
+        try await fetch(wholePasslists: true)
+        #expect(RealtimeBoardProtocol.requests(host).map(Self.passlistCap) == ["10", nil])
+    }
+}
