+        // EXPERIMENT (scratch arm D only): also assemble from recorded boards of the same stop whose
+        // window overlaps the query, keeping rows planned inside the query's window.
+        func span(_ key: String) -> (base: String, start: Date, end: Date)? {
+            var date = "", time = "", duration = 0.0, rest: [String] = []
+            for item in key.split(separator: "?").last?.split(separator: "&") ?? [] {
+                let parts = item.split(separator: "=", maxSplits: 1).map(String.init)
+                switch parts.first {
+                case "date": date = parts.last ?? ""
+                case "time": time = parts.last ?? ""
+                case "duration": duration = Double(parts.last ?? "") ?? 0
+                default: rest.append(String(item))
+                }
+            }
+            let formatter = DateFormatter()
+            formatter.locale = Locale(identifier: "en_US_POSIX"); formatter.timeZone = TimeZone(identifier: "UTC")
+            formatter.dateFormat = "yyyy-MM-dd HH:mm:ss"
+            guard let start = formatter.date(from: date + " " + time) else { return nil }
+            return (rest.joined(separator: "&"), start, start.addingTimeInterval(duration * 60))
+        }
+        let wantedSpan = span(window)
+        let candidates = bodies.filter { item in
+            if item.value.window == window { return true }
+            guard let wantedSpan, let other = span(item.value.window) else { return false }
+            return other.base == wantedSpan.base && other.start < wantedSpan.end && other.end > wantedSpan.start
+        }.sorted { $0.key < $1.key }
