    "Name this trip so you can re-plan it in one tap. Use “Home → Work” for time-of-day commute suggestions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne diese Fahrt, um sie mit einem Fingertipp neu zu planen. Verwende „Zuhause → Arbeit“ für Pendelvorschläge nach Tageszeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nommez ce trajet pour pouvoir le replanifier d’un geste. Utilisez « Maison → Travail » pour les suggestions de trajet selon l’heure."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gëff dëser Rees en Numm, fir se mat engem Klick nei ze plangen. Benotz „Doheem → Schaffen“ fir Pendelvirschléi no Dageszäit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um nome a esta viagem para a poder planear novamente com um toque. Use “Casa → Trabalho” para sugestões de deslocação consoante a hora do dia."
          }
        }
      }
    },
