    "Plan journeys from the static schedule only, without live departures, delays, or cancellations. Adds a 15-minute minimum between transfers as a safety buffer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plant Fahrten nur anhand des statischen Fahrplans – ohne Live-Abfahrten, Verspätungen oder Ausfälle. Fügt zwischen Umstiegen mindestens 15 Minuten Sicherheitspuffer hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez les trajets uniquement à partir des horaires statiques, sans départs en temps réel, retards ni annulations. Ajoute un délai de sécurité minimum de 15 minutes entre les correspondances."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plangt Reesen nëmmen nom statesche Fuerplang, ouni Live-Departuren, Verspéidungen oder Annulatiounen. Setzt e Sécherheetspuffer vu mindestens 15 Minutten tëscht den Ëmsteigen dobäi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
