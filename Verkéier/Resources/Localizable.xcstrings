    "Location is used on device. Saved places and trips stay on this device. No account or ads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort wird auf dem Gerät verwendet. Gespeicherte Orte und Fahrten bleiben auf diesem Gerät. Kein Konto und keine Werbung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position est utilisée sur l’appareil. Les lieux et trajets enregistrés restent sur cet appareil. Aucun compte ni publicité."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
